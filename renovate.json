{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["gomod", "github-actions"],
  "automerge": false,
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Group Go module minor and patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules (non-major)"
    },
    {
      "description": "Keep Go toolchain directive updates in one PR",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Group golang.org/x module updates",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "groupName": "golang.org/x"
    },
    {
      "description": "Label separate major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["go-major"]
    },
    {
      "description": "Group GitHub Actions minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    }
  ]
}
